# ============================================================
# XSignals AI 配置模板
# 复制本文件为 .env 后填入自己的真实值（.env 不要提交到 git）
# ============================================================

# ---- OpenRouter（AI 解读，必填）----
# 到 https://openrouter.ai/keys 获取
OPENROUTER_API_KEY=sk-or-v1-your_key_here
# 模型 ID：可填任意 OpenRouter 模型（如 Claude、DeepSeek 等）
MODEL_NAME=deepseek/deepseek-v4.1-flash-1017

# ---- 币安 API（仅实盘需要；模拟盘/分析不需要）----
# 若只做模拟盘，可留空
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 中国大陆需通过代理访问 api.binance.com 才能实盘下单
BINANCE_PROXY=

# ---- 监测币种 ----
MONITOR_SYMBOL=SOLUSDT

# ---- Server酱（微信推送，必填）----
# 到 https://sct.ftqq.com/ 微信扫码登录后获取 SendKey
SERVERCHAN_SENDKEY=SCTyour_sendkey_here
# 推送模式：always=每次都推 / on_change=仅信号变化时推 / on_signal=仅强信号时推
PUSH_MODE=always

# ---- 模拟盘参数 ----
PAPER_START_BALANCE=1000
# 每笔风险占权益比例（0.02 = 2%）
PAPER_RISK_PCT=0.02
# 单笔最大仓位占权益比例（0.30 = 30%）
PAPER_MAX_PCT=0.30
# 止损 = ATR × 该倍数
PAPER_ATR_STOP_MULT=1.5
# 止盈 = ATR × 该倍数（1:2 盈亏比）
PAPER_ATR_TP_MULT=3.0
# 开仓最低置信度（%）
PAPER_MIN_CONF=60
# 信号平仓最低置信度（%）
PAPER_EXIT_CONF=55
# 最低趋势强度 ADX
PAPER_MIN_ADX=18
# 最低量能倍数
PAPER_MIN_VOL=0.7
# 距压力位最小空间（%）
PAPER_MIN_SPACE=0.5

# ---- 交易时段（小时，24 小时制）----
MONITOR_START_HOUR=8
MONITOR_END_HOUR=20

# ---- 网页面板（可选）----
WEB_PIN=1234
WEB_PORT=5000
# 实盘开关：默认 false（只做模拟）。开启前请确保有可用代理且已理解风险
LIVE_TRADING=false
MAX_ORDER_USDT=50
